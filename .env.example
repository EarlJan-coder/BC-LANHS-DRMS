# PostgreSQL
DATABASE_URL="postgres://postgres:postgres@localhost:5432/lanhs_drms"

# Migration guard: `npm run db:migrate` (scripts/check-migrations.ts) refuses to run
# pending irreversible data deletes (0006 users wipe, 0008 Certificate of Grades /
# grade data) unless this is "true". Take a backup (pg_dump) before setting it.
ALLOW_DESTRUCTIVE_MIGRATIONS=""

# Local Authentication
# Generate a separate random value for each environment; at least 32 bytes.
SESSION_SECRET=""

# Trust reverse-proxy forwarding headers (X-Real-IP / X-Forwarded-For) for
# per-IP login rate limiting. Leave unset (or "false") when the app is served
# directly: without a proxy those headers are client-supplied and would let
# attackers rotate addresses to bypass the IP buckets.
TRUST_PROXY=""

# Auth attempt limits per 15-minute window (optional; defaults shown).
# IP_ATTEMPT_LIMIT caps all attempts per trusted client address.
# LOGIN_ATTEMPT_LIMIT caps attempts per email/LRN (login) and per LRN (signup).
IP_ATTEMPT_LIMIT="20"
LOGIN_ATTEMPT_LIMIT="5"

# Sample data seeding (`npm run db:seed`)
# SEED_PASSWORD: required; 8-72 bytes; used by the four sample accounts.
# Development only — the seeder refuses to run when NODE_ENV is production.
SEED_PASSWORD=""
# Set to "true" to allow seeding a database on a non-local host
# (the seeder refuses remote databases otherwise).
ALLOW_REMOTE_SEED=""

# Resend Email
RESEND_API_KEY=""
RESEND_FROM_EMAIL="LANHS DRMS <no-reply@lanhsdrms.online>"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Blockchain / Hardhat / Sepolia
BLOCKCHAIN_PRIVATE_KEY=""
SEPOLIA_RPC_URL=""
CONTRACT_ADDRESS=""
HARDHAT_NETWORK="hardhat"

# Certificate signing / verification secret (reserved; no code currently reads this)
CERTIFICATE_SECRET="replace-with-a-long-random-secret"

# Backward-compatible aliases supported by the app
BLOCKCHAIN_RPC_URL=""
DOCUMENT_AUDIT_CONTRACT_ADDRESS=""
